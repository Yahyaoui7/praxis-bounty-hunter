# Praxis POC — Environment Variables
# Copy this file to .env and change the values for production.

# Secret key for signing session cookies (CHANGE THIS in production!)
# GitLab Integration Configuration (Phase 2 Foundation)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=change-me
GITLAB_NAMESPACE_ID=
GITLAB_TEMPLATE_PROJECT_ID=

# Praxis Configuration
SECRET_KEY=praxis-poc-secret-key-change-me
ADMIN_PASSWORD=admin-poc-password

# ---------------------------------------------------------
# INTRA 42 OAUTH SETTINGS (Phase 2 - 1337 Auth)
# ---------------------------------------------------------
# Get these by creating an application in your Intra 42 settings:
# https://profile.intra.42.fr/oauth/applications
INTRA_CLIENT_ID=your-intra-client-id
INTRA_CLIENT_SECRET=your-intra-client-secret
# IMPORTANT: In Kubernetes, this MUST be the public Ingress hostname (e.g. https://praxis.1337.ma/auth/callback)
# Using an IP address or localhost will break when the pod moves to a different node.
INTRA_REDIRECT_URI=http://10.12.2.14:8000/auth/callback

# ---------------------------------------------------------
# EVALUATION BACKEND SETTINGS (Phase 3)
# ---------------------------------------------------------
# Choose between 'docker' (for local dev) or 'kubernetes' (for production)
EVAL_BACKEND=kubernetes
# Namespace where Kubernetes Jobs will be created (only used if EVAL_BACKEND=kubernetes)
EVAL_NAMESPACE=praxis
# Image to use for evaluator pods
EVALUATOR_IMAGE=praxis-evaluator:latest

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# Local SQLite for POC:
DATABASE_URL=sqlite:///./praxis.db
# PostgreSQL for Kubernetes (REQUIRED for production so data isn't lost when pods restart):
# DATABASE_URL=postgresql://praxis:secret-password@postgres-service:5432/praxis
